# ============================================================================
# Edible House Automator - Environment Configuration
# Скопіюй цей файл як .env та заповни своїми API ключами
# ============================================================================

# ============================================================================
# API KEYS (REQUIRED)
# ============================================================================

# Higgsfield AI
# Отримай на: https://cloud.higgsfield.ai/
HIGGSFIELD_API_KEY=your_higgsfield_api_key_here
HIGGSFIELD_API_SECRET=your_higgsfield_api_secret_here

# Google Gemini
# Отримай на: https://makersuite.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude (OPTIONAL - тільки якщо використовуєш Claude для ContentBrain)
# Отримай на: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Telegram Bot
# Створи через @BotFather в Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# RunPod (OPTIONAL - Cloud GPU альтернатива Topaz)
# Отримай на: https://www.runpod.io/console/user/settings
RUNPOD_API_KEY=

# ============================================================================
# AI MODELS CONFIGURATION
# ============================================================================

# ContentBrain Provider: gemini | claude
# За замовчуванням використовується Gemini
CONTENTBRAIN_PROVIDER=gemini

# ContentBrain Model
# Для Gemini: gemini-1.5-pro | gemini-1.5-flash
# Для Claude: claude-3-5-sonnet-20241022 | claude-3-opus-20240229
CONTENTBRAIN_MODEL=gemini-1.5-pro

# Gemini Validator Model
GEMINI_VALIDATOR_MODEL=gemini-1.5-pro

# Gemini Temperature (0.0-2.0)
GEMINI_TEMPERATURE=0.3

# ============================================================================
# HIGGSFIELD SETTINGS
# ============================================================================

# Base URL (не міняй якщо не знаєш навіщо)
HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai

# Модель для генерації зображень
# Nano Banana Pro - Google Gemini 3 Pro Image (4K, швидкий, чіткий текст)
# ВАЖЛИВО: Перевір точну назву в Higgsfield dashboard (cloud.higgsfield.ai/explore)
# Можливі варіанти: nano-banana-pro | google/nano-banana-pro/text-to-image
HIGGSFIELD_IMAGE_MODEL=nano-banana-pro

# Модель для генерації відео
# Kling v2.6 - Native Audio + кращі переходи
# ВАЖЛИВО: Перевір точну назву в Higgsfield dashboard
# Можливі варіанти: kling-video/v2.6/pro/image-to-video | kling/v2.6/image-to-video
HIGGSFIELD_VIDEO_MODEL=kling-video/v2.6/pro/image-to-video

# Співвідношення сторін для зображень
HIGGSFIELD_ASPECT_RATIO=16:9

# Роздільна здатність зображень
HIGGSFIELD_RESOLUTION=720p

# Тривалість відео (секунди, 1-10)
HIGGSFIELD_VIDEO_DURATION=5

# ============================================================================
# PROCESSING SETTINGS
# ============================================================================

# Максимальна кількість повторів при помилках (0-5)
MAX_RETRIES=2

# Кількість одночасних Topaz процесів (1-3, рекомендовано 1)
TOPAZ_QUEUE_LIMIT=1

# Кількість сцен для паралельної обробки (1-10)
CONCURRENT_SCENES=5

# Timeout для HTTP запитів (секунди)
REQUEST_TIMEOUT=300

# Інтервал polling для перевірки статусу (секунди)
POLLING_INTERVAL=5

# Кількість останніх тем для blacklist (5-100, по замовчуванню 20)
TOPIC_MEMORY_LIMIT=20

# ============================================================================
# TOPAZ VIDEO AI SETTINGS
# ============================================================================

# Шлях до Topaz FFmpeg
# Windows: C:\Program Files\Topaz Labs LLC\Topaz Video AI\ffmpeg.exe
TOPAZ_FFMPEG_PATH=C:\Program Files\Topaz Labs LLC\Topaz Video AI\ffmpeg.exe

# Модель Topaz для upscaling
# Дізнайся доступні: ffmpeg.exe -h filter=tvai_up
# Популярні: alq-13 | proteus | artemis-lq-v14
TOPAZ_MODEL=alq-13

# Коефіцієнт масштабування (1-4x)
TOPAZ_SCALE=2

# Bitrate для вихідного відео
TOPAZ_BITRATE=5000k

# ============================================================================
# ADSPOWER & WEB AUTOMATION SETTINGS
# ============================================================================

# AdsPower API для браузерної автоматизації Higgsfield
# Увімкни HIGGSFIELD_WEB_ENABLED=true для використання Ultimate підписки
ADSPOWER_API_KEY=your_adspower_api_key
ADSPOWER_BASE_URL=http://local.adspower.net:50325
ADSPOWER_PROFILE_ID=your_profile_id

# Використовувати веб-автоматизацію замість API (true/false)
HIGGSFIELD_WEB_ENABLED=true

# Aspect ratio для веб-генерації (9:16 для YouTube Shorts)
HIGGSFIELD_WEB_ASPECT_RATIO=9:16

# Роздільна здатність зображень (1K, 2K)
HIGGSFIELD_WEB_IMAGE_RESOLUTION=2K

# Модель для відео генерації
HIGGSFIELD_WEB_VIDEO_MODEL=Kling 2.6

# Тривалість відео (5 або 10 секунд)
HIGGSFIELD_WEB_VIDEO_DURATION=10

# Використовувати простий послідовний генератор відео (рекомендовано)
# true = SimpleVideoGenerator (надійний, послідовний)
# false = KlingVideoGenerator (паралельний, складніший)
USE_SIMPLE_VIDEO_GENERATOR=true

# ============================================================================
# WEB UI SETTINGS
# ============================================================================

# Host для FastAPI сервера
WEB_HOST=127.0.0.1

# Port для FastAPI сервера
WEB_PORT=8000

# ============================================================================
# LOGGING SETTINGS
# ============================================================================

# Рівень логування: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Розмір файлу для ротації логів
LOG_ROTATION=10 MB

# Час зберігання старих логів
LOG_RETENTION=1 week

# ============================================================================
# RUNPOD CLOUD GPU SETTINGS (альтернатива локальному Topaz)
# ============================================================================

# Увімкнути RunPod замість локального Topaz (true/false)
RUNPOD_ENABLED=false

# Тип GPU для RunPod
# Доступні: NVIDIA GeForce RTX 3090 | NVIDIA GeForce RTX 4090 | NVIDIA RTX A5000
RUNPOD_GPU_TYPE=NVIDIA GeForce RTX 3090

# Тип хмари: SECURE (гарантований, дорожчий) | COMMUNITY (дешевший, може перерватись)
RUNPOD_CLOUD_TYPE=COMMUNITY

# Розмір диска для pod (GB)
RUNPOD_VOLUME_GB=50

# Автоматично зупиняти pod після обробки (true/false)
RUNPOD_AUTO_TERMINATE=true

# Timeout очікування запуску pod (секунди)
RUNPOD_POD_TIMEOUT=300

# Timeout обробки відео (секунди)
RUNPOD_JOB_TIMEOUT=1800

# Модель для upscaling
# realesr-animevideov3 - оптимізована для анімації та AI-generated контенту
# RealESRGAN_x4plus - загальна модель для реальних відео
RUNPOD_UPSCALE_MODEL=realesr-animevideov3

# Модель для frame interpolation
RUNPOD_INTERPOLATION_MODEL=rife-v4.6

# ============================================================================
# ПРИМІТКИ
# ============================================================================

# 1. Цей файл НЕ повинен комітитися в Git (.gitignore)
# 2. Після створення .env файлу, перевір що всі REQUIRED ключі заповнені
# 3. Для першого запуску достатньо заповнити тільки API keys
# 4. Усі інші параметри мають розумні значення за замовчуванням
# 5. Щоб змінити ContentBrain на Claude, встанови:
#    CONTENTBRAIN_PROVIDER=claude
#    CONTENTBRAIN_MODEL=claude-3-5-sonnet-20241022
#    ANTHROPIC_API_KEY=your_key
# 6. Щоб використовувати RunPod замість Topaz:
#    RUNPOD_ENABLED=true
#    RUNPOD_API_KEY=your_runpod_key
